# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Verify exact model IDs in the Console before use.
KAARAN_MODEL_MAIN=claude-sonnet-5-5
KAARAN_MODEL_LIGHT=claude-haiku-5-5
# KAARAN_ENV is a label only (not read by the code)
KAARAN_ENV=dev
# Spend caps (per process): live Claude in USD, Sarvam voice in INR
KAARAN_MAX_LIVE_USD=15
KAARAN_MAX_VOICE_INR=100
# LLM mode: replay (recorded answers only, offline, default) | live (recorded first, then the API) | off
KAARAN_LLM_MODE=replay
# Demo: dataset the web/WhatsApp demo opens with (blocks | blocks_fictional = cluster lens; solapur | fictional = taluka lens)
KAARAN_DEMO_DATASET=blocks
KAARAN_BROWSER=
# WhatsApp Cloud API (Meta developer app > WhatsApp > API Setup). See docs/DEMO.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0
# Voice (Sarvam AI): speech-to-text in, one-minute voice summary out. Key goes in .env (never commit).
SARVAM_API_KEY=
KAARAN_STT_MODEL=saaras:v4
KAARAN_TTS_MODEL=bulbul:v4-flash
KAARAN_TTS_SPEAKER_MR=ritu_mr_narration
KAARAN_TTS_SPEAKER_EN=ritu_en_edtech
KAARAN_TTS_PACE=1.0
# KAARAN_VOICE=off disables voice even with a key; KAARAN_VOICE_REPLY=off stops WhatsApp voice notes
KAARAN_VOICE=on
KAARAN_VOICE_REPLY=on
# Server
KAARAN_HOST=127.0.0.1
PORT=8000
# Deploy to Hugging Face Spaces (scripts/deploy_hf.py; docs/DEPLOY.md)
HF_TOKEN=
HF_USER=
# WhatsApp Business Account ID (API Setup page; an id, not a secret) - scripts/whatsapp_setup.py
WHATSAPP_WABA_ID=
