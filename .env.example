# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Verify exact model IDs in the Console before use.
KAARAN_MODEL_MAIN=claude-sonnet-5-5
KAARAN_MODEL_LIGHT=claude-haiku-5-5
KAARAN_ENV=dev
# LLM mode: replay (recorded answers only, offline, default) | live (recorded first, then the API) | off
KAARAN_LLM_MODE=replay
# Demo: dataset the web/WhatsApp demo opens with (blocks | blocks_fictional = cluster lens; solapur | fictional = taluka lens)
KAARAN_DEMO_DATASET=blocks
KAARAN_BROWSER=
# WhatsApp Cloud API (Meta developer app > WhatsApp > API Setup). See docs/DEMO.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0
# Voice (Sarvam AI): speech-to-text in, one-minute voice summary out. Key goes in .env (never commit).
SARVAM_API_KEY=
KAARAN_STT_MODEL=saaras:v4
KAARAN_TTS_MODEL=bulbul:v4-flash
KAARAN_TTS_SPEAKER_MR=ritu_mr_narration
KAARAN_TTS_SPEAKER_EN=ritu_en_edtech
KAARAN_TTS_PACE=1.0
